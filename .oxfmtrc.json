{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/*.gen.ts", "packages/sdk/src/gen/**", "apps/backend/openapi.json"],
  "overrides": [
    {
      "files": ["apps/web/**"],
      "options": {
        "sortImports": {
          "newlinesBetween": false,
          "customGroups": [
            {
              "groupName": "bun",
              "elementNamePattern": ["bun", "bun:*"]
            },
            {
              "groupName": "react",
              "elementNamePattern": ["react", "react-dom"]
            },
            {
              "groupName": "tanstack-start",
              "elementNamePattern": ["@tanstack/react-start", "@tanstack/react-start/**"]
            },
            {
              "groupName": "tanstack",
              "elementNamePattern": ["@tanstack/**"]
            },
            {
              "groupName": "workspace",
              "elementNamePattern": ["@takobox/**"]
            }
          ],
          "groups": [
            ["side_effect"],
            ["builtin", "bun"],
            ["react"],
            ["tanstack-start"],
            ["tanstack"],
            ["external"],
            ["workspace"],
            ["internal", "subpath"],
            ["style"],
            ["unknown"]
          ]
        },
        "sortTailwindcss": {
          "stylesheet": "./apps/web/src/index.css",
          "functions": ["cn", "cva", "tw"]
        }
      }
    },
    {
      "files": ["**/Cargo.toml"],
      "options": {
        "printWidth": 200
      }
    }
  ]
}
