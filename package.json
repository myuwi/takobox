{
  "name": "takobox",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "dev": "concurrently -k \"bun:dev:*\"",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bacon apps/backend -j run-long --headless",
    "dev:caddy": "docker compose --project-name takobox-dev -f docker-compose.dev.yml up",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --cwd e2e test",
    "test:e2e:ui": "bun run --cwd e2e test:ui",
    "test:e2e:install": "bun install --cwd e2e --frozen-lockfile && bun run --cwd e2e install:browsers",
    "generate": "cargo run --manifest-path apps/backend/Cargo.toml --bin openapi > apps/backend/openapi.json && bun run --cwd packages/sdk generate",
    "fmt": "oxfmt . --check",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "docker": "docker compose -f docker-compose.build.yml up --build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001"
  }
}
